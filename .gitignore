# ---------------------------------------------------------------------------
# Seirin .gitignore
# Project ASSETS (backgrounds/, characters/, cg/, references/, plans/) are the
# product and stay tracked on purpose — the archive tooling in tools/ commits
# them deliberately. This file keeps junk, tooling and regenerable artifacts
# out of Git. Do NOT add asset directories here.
# ---------------------------------------------------------------------------

# OS junk
.DS_Store
Thumbs.db
desktop.ini
.directory

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~
.fleet/

# Rejected/in-progress character generations. Approved assets AND their prompt
# files (characters/<id>/prompts/) are committed on purpose — the prompts are
# part of the product. Only _wip/ is throwaway.
characters/*/_wip/
characters/_wip/

# Scratch spaces & uploads (never part of the game or the asset set)
uploads/
scratch/
tmp/
*.tmp
*.bak
*.orig

# JavaScript tooling (failsafe unit tests are dependency-free; jsdom is a
# dev-only dependency of the offline smoke test and must never ship)
node_modules/
package-lock.json
npm-debug.log*
yarn-error.log*
.npx-cache/

# Python tooling (browser regression test; matting tools need Pillow + numpy,
# install into a local venv — never commit it)
__pycache__/
*.py[cod]
.venv/
.venv-art/
.venv_art/
venv/
.pytest_cache/
playwright-report/
test-results/

# Logs & profiling
*.log
*.tgz
*.cpuprofile

# Note: archives/*.tar.gz + archives/*.bundle are INTENTIONAL, small project
# snapshots produced by tools/ and stay tracked. If you ever generate
# throwaway archives elsewhere, ignore those paths individually instead.

# UI screenshots are transient review artifacts, not project deliverables.
# Keep them out of Git; concept boards remain JPEG-only.
design/preview/shots/
design/concepts/*.png

# Compiled art-pipeline binaries: rebuild each session with
# tools/img_pipeline/build.sh (gcc -O2, a few seconds). Source (.c/.h) is
# committed; the platform-specific binary is not.
tools/img_pipeline/upscale_filter
tools/img_pipeline/matte_floodfill

# Public research PDFs are indexed by character_design_sources/README.md and
# summarized in the compact Sourcebook; do not re-add the heavyweight mirror.
ai_agent_docs/character_design_sources/JP/*.pdf
ai_agent_docs/character_design_sources/CN/*.pdf
